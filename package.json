{
  "name": "fio-basic-boilerplate",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack",
    "build": "next build",
    "build:cloudflare": "opennextjs-cloudflare build",
    "start": "next start",
    "preview": "bun run build:cloudflare && opennextjs-cloudflare preview",
    "deploy": "bun run build:cloudflare && opennextjs-cloudflare deploy",
    "upload": "bun run build:cloudflare && opennextjs-cloudflare upload",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "lint": "eslint",
    "format": "prettier --write \"**/*.{ts,tsx}\"",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@bprogress/next": "^3.2.12",
    "@opennextjs/cloudflare": "^1.20.2",
    "@tanstack/react-query": "^5.100.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.11.0",
    "motion": "^12.38.0",
    "next": "16.2.11",
    "next-themes": "^0.4.6",
    "ofetch": "^1.5.1",
    "qs": "^6.15.1",
    "radix-ui": "^1.4.3",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "shadcn": "^4.14.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.5.0",
    "takumi-js": "^2.9.2",
    "tw-animate-css": "^1.4.0",
    "zustand": "^5.0.13"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@radix-ui/react-slot": "^1.2.4",
    "@tailwindcss/postcss": "^4.2.1",
    "@types/node": "^25.5.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "eslint": "^9.39.4",
    "eslint-config-next": "16.2.11",
    "postcss": "^8",
    "prettier": "^3.8.1",
    "prettier-plugin-tailwindcss": "^0.7.2",
    "tailwindcss": "^4.2.1",
    "typescript": "^5.9.3",
    "wrangler": "^4.123.0"
  }
}
